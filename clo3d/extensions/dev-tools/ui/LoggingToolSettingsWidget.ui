        color: rgba(110, 185, 255, 255);
}

QLineEdit:focus {
        background: rgba(37, 37, 40, 255);
        color: rgba(110, 185, 255, 255);
}

QLineEdit[widget-type=&quot;Warning&quot;] {
        background: rgba(40, 32, 35, 255);
        color: rgba(255, 97, 125, 255);
}

QLineEdit[readOnly=&quot;true&quot;], QLineEdit[widget-type=&quot;ReadOnly&quot;] {
        background: transparent;
        color: rgba(153, 153, 156, 255);
}

QLineEdit:disabled {
        background: rgba(37, 37, 40, 255);
        color: rgba(70, 70, 73, 255);
}</string>
