root = @CMAKE_SOURCE_DIR@
filter = @CMAKE_SOURCE_DIR@/@MODULE_SOURCE@/src/*
filter = @CMAKE_SOURCE_DIR@/@MODULE_SOURCE@/include/*
exclude = @CMAKE_SOURCE_DIR@/.conan/.*

calls = yes
decisions = yes

sort = filename
print-summary = yes

html-theme = github.dark-blue
html-title = Chrysalis - @MODULE_NAME@ Test Coverage
html-details = @DOCUMENTATION_DIR@/coverage/@MODULE_OUTPUT@/index.html