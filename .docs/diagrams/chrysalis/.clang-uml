compilation_database_dir: ../../../.build/Debug
output_directory: .
remove_compile_flags:
  - -ffp-model=strict
  - -ffp-exception-behavior=strict
add_compile_flags:
  - /clang:-fparse-all-comments
  - /clang:-ffp-exception-behavior=ignore
  - /clang:-U__llvm__
diagrams:
  PatternClassDiagram:
      type: class
      glob:
        include:
          - ../../../pattern/src/*.cpp
      exclude:
        namespaces:
          - std
          - CGAL
          - boost
        paths:
          - ../../../.conan
        relationships:
          - dependency
      plantuml:
        after:
          - >
            skinparam class {
              BackgroundColor #EAFAF1
              BorderColor #1E8449
              FontColor #0B5345
              AttributeFontColor #1E8449
              StereotypeFontColor #1E8449
              FontStyle Bold
            }
          - >
            skinparam class<<Base>> {
              BackgroundColor #F2F3F4
              BorderColor #2C3E50
              BorderThickness 3
              FontSize 16
              FontColor #2C3E50
              AttributeFontColor #566573
              StereotypeFontColor #808B96
              FontStyle Italic
            }
          - >
            {% for e in diagram.elements %}
            {% if replace(e.name, "Base", "") != e.name %}class {{ e.alias }} <<Base>>{% endif %}
            {% endfor %}