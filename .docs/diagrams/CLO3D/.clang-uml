add_compile_flags:
  - -U__llvm__
  - -fparse-all-comments
  - -D_CRT_USE_BUILTIN_OFFSETOF
  - -D__CLANG_UML__
diagrams:
  CLO3DDevToolsUIExporterClassDiagram:
    type: class
    glob:
      include:
        - r: ".*UIExporter.*"
    exclude:
      namespaces:
        - std
        - CLO3D::UI::Ui
      elements:
        - WidgetPlugin
        - ContainerPlugin
        - BaseUIExporterSettingsBlockContainerWidgetPlugin
        - r: "QList.*"
        - type: method
          name:
            r: '.*::(qt_metacall|qt_static_metacall|qt_metacast|metaObject|tr|trUtf8|staticMetaObject)$'
        - type: member
          name:
            r: '.*::staticMetaObject$'
      paths:
        - ../../../.conan
        - ../../../logging
        - ../../../integrations/clo3d/widgets
      relationships:
        - dependency
    layout:
      BaseUIExporterOptions:
        - down: BaseUIExporterOptions::Keys
        - down: BaseUIExporterOptions::Defaults
      GeneralUIExporterOptions:
        - down: GeneralUIExporterOptions::Keys
        - down: GeneralUIExporterOptions::Defaults
      JsonUIExporterOptions:
        - down: JsonUIExporterOptions::Keys
        - down: JsonUIExporterOptions::Defaults
      XmlUIExporterOptions:
        - down: XmlUIExporterOptions::Keys
        - down: XmlUIExporterOptions::Defaults
    plantuml:
      after:
        - >
          skinparam class {
            BackgroundColor #EAFAF1
            BorderColor #1E8449
            FontColor #0B5345
            AttributeFontColor #1E8449
            StereotypeFontColor #1E8449
            FontStyle Bold
          }
        - >
          skinparam class<<CLO3D::UI>> {
            BackgroundColor #F5EEF8
            BorderColor #8E44AD
            FontColor #4A235A
            AttributeFontColor #6C3483
            StereotypeFontColor #6C3483
          }
        - >
          skinparam class<<Base>> {
            BackgroundColor #F2F3F4
            BorderColor #2C3E50
            BorderThickness 3
            FontSize 16
            FontColor #2C3E50
            AttributeFontColor #566573
            StereotypeFontColor #808B96
            FontStyle Italic
          }
        - >
          skinparam class<<Extension>> {
            BackgroundColor #F9EBEA
            BorderColor #7B241C
            BorderThickness 3
            FontSize 16
            FontColor #7B241C
            AttributeFontColor #A93226
            StereotypeFontColor #CD6155
            FontStyle Italic
          }
        - >
          {% for e in diagram.elements %}

          {% if e.namespace != "" %}
          class {{ e.alias }} <<{{ e.namespace }}>> {% if replace(e.name, "Base", "") != e.name %}<<Base>>{% endif %}
          {% else if replace(e.name, "Base", "") != e.name %}
          class {{ e.alias }} <<Base>>
          {% else if replace(e.name, "Extension", "") != e.name and replace(e.name, "Extensions", "") == e.name %}
          class {{ e.alias }} <<Extension>>
          {% else %}
          {% endif %}

          {% endfor %}
  CLO3DDevToolsLoggingClassDiagram:
    type: class
    glob:
      include:
        - r: ".*Logging.*"
    exclude:
      namespaces:
        - std
        - fmt
        - spdlog
        - CLO3D::UI::Ui
      elements:
        - QFlags<Qt::ItemFlag>
        - BaseNativeShortcutHandler
        - type: class
          name:
            r: '.*UIExporter.*'
        - type: class
          name:
            r: '.*Formatter.*'
        - type: method
          name:
            r: '.*::(qt_metacall|qt_static_metacall|qt_metacast|metaObject|tr|trUtf8|staticMetaObject)$'
        - type: member
          name:
            r: '.*::staticMetaObject$'
      paths:
        - ../../../.conan
        - ../../../integrations/clo3d/widgets
      relationships:
        - dependency
    layout:
      LoggingToolSettings:
        - down: LoggingToolSettings::Keys
        - down: LoggingToolSettings::Defaults
    plantuml:
      after:
        - >
          skinparam class {
            BackgroundColor #EAFAF1
            BorderColor #1E8449
            FontColor #0B5345
            AttributeFontColor #1E8449
            StereotypeFontColor #1E8449
            FontStyle Bold
          }
        - >
          skinparam class<<CLO3D::UI>> {
            BackgroundColor #F5EEF8
            BorderColor #8E44AD
            FontColor #4A235A
            AttributeFontColor #6C3483
            StereotypeFontColor #6C3483
          }
        - >
          skinparam class<<Base>> {
            BackgroundColor #F2F3F4
            BorderColor #2C3E50
            BorderThickness 3
            FontSize 16
            FontColor #2C3E50
            AttributeFontColor #566573
            StereotypeFontColor #808B96
            FontStyle Italic
          }
        - >
          skinparam class<<Extension>> {
            BackgroundColor #F9EBEA
            BorderColor #7B241C
            BorderThickness 3
            FontSize 16
            FontColor #7B241C
            AttributeFontColor #A93226
            StereotypeFontColor #CD6155
            FontStyle Italic
          }
        - >
          {% for e in diagram.elements %}

          {% if e.namespace != "" %}
          class {{ e.alias }} <<{{ e.namespace }}>> {% if replace(e.name, "Base", "") != e.name %}<<Base>>{% endif %}
          {% else if replace(e.name, "Base", "") != e.name %}
          class {{ e.alias }} <<Base>>
          {% else if replace(e.name, "Extension", "") != e.name and replace(e.name, "Extensions", "") == e.name %}
          class {{ e.alias }} <<Extension>>
          {% else %}
          {% endif %}

          {% endfor %}
  CLO3DChrysalisPatternImportClassDiagram:
    type: class
    glob:
      include:
        - ../../../integrations/clo3d/extensions/chrysalis/src/ParameterWidget.cpp
        - ../../../integrations/clo3d/extensions/chrysalis/src/PatternImportDialog.cpp
    exclude:
      namespaces:
        - std
        - CGAL
        - boost
        - CLO3D::UI::Ui
      elements:
        - type: class
          name:
            r: '.*Argument.*'
        - type: class
          name:
            r: '.*BaseContainer.*'
        - type: method
          name:
            r: '.*::(qt_metacall|qt_static_metacall|qt_metacast|metaObject|tr|trUtf8|staticMetaObject)$'
        - type: member
          name:
            r: '.*::staticMetaObject$'
      paths:
        - ../../../.conan
        - ../../../logging
        - ../../../integrations/clo3d/src
        - ../../../integrations/clo3d/widgets/src
      relationships:
        - dependency
    plantuml:
      after:
        - >
          skinparam class {
            BackgroundColor #EAFAF1
            BorderColor #1E8449
            FontColor #0B5345
            AttributeFontColor #1E8449
            StereotypeFontColor #1E8449
            FontStyle Bold
          }
        - >
          skinparam class<<CLO3D::UI>> {
            BackgroundColor #F5EEF8
            BorderColor #8E44AD
            FontColor #4A235A
            AttributeFontColor #6C3483
            StereotypeFontColor #6C3483
          }
        - >
          skinparam class<<Base>> {
            BackgroundColor #F2F3F4
            BorderColor #2C3E50
            BorderThickness 3
            FontSize 16
            FontColor #2C3E50
            AttributeFontColor #566573
            StereotypeFontColor #808B96
            FontStyle Italic
          }
        - >
          skinparam class<<Model>> {
            BackgroundColor #E8F8F5
            BorderColor #0E6655
            BorderThickness 3
            FontSize 16
            FontColor #0E6655
            AttributeFontColor #117A65
            StereotypeFontColor #148F77
            FontStyle Italic
          }
        - >
          {% for e in diagram.elements %}

          {% if e.namespace != "" %}
          class {{ e.alias }} <<{{ e.namespace }}>> {% if replace(e.name, "Base", "") != e.name %}<<Base>>{% endif %}
          {% else if replace(e.name, "Base", "") != e.name %} class {{ e.alias }} <<Base>>
          {% else if replace(e.name, "Model", "") != e.name %} class {{ e.alias }} <<Model>>
          {% endif %}

          {% endfor %}
  CLO3DCommandsClassDiagram:
    type: class
    glob:
      include:
