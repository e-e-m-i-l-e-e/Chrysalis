import os

project = 'Chrysalis'
copyright = '2026, emilyyy0621@gmail.com'
author = 'emilyyy0621@gmail.com'
release = '1.0'

DOCS_SOURCE_DIR = "@CMAKE_CURRENT_SOURCE_DIR@/sphinx/source"

extensions = [
    "breathe",
    "sphinxcontrib.plantuml"
]

breathe_projects = {
    "Chrysalis": "@DOXYGEN_XML_DIR@"
}
breathe_default_project = "Chrysalis"

plantuml_output_format = 'svg'
plantuml = r'java -jar C:/Life/Design/Apps/Chrysalis/.build/Debug/_deps/plantuml_jar-src/plantuml.jar'

templates_path = [
    os.path.join(DOCS_SOURCE_DIR, "_templates")
]

exclude_patterns = []

html_theme = 'sphinxawesome_theme'
html_title = 'Chrysalis'
html_permalinks = False

html_static_path = [
    os.path.join(DOCS_SOURCE_DIR, "_static")
]

html_css_files = [
    'custom.css'
]

html_sidebars = {
    'index': [],
    'search': [],
    'app/index': [],
    'app/chrysalis*': ['sidebar_section_nav.html'],
    'app/clo3d*': ['sidebar_section_nav.html'],
    'app/clo3d/**': ['sidebar_section_nav.html'],
    'app/valentina*': ['sidebar_section_nav.html'],
    'module/index': [],
    'module/pattern*': ['sidebar_section_nav.html'],
    'module/renderer*': ['sidebar_section_nav.html'],
    'module/hooks*': ['sidebar_section_nav.html'],
    'development/**': ['sidebar_section_nav.html'],
}

html_theme_options = {
    "main_nav_links": {
        "Applications": "/app/",
        "Modules": "/module/",
    },
}