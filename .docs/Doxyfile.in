PROJECT_NAME = Chrysalis

OUTPUT_DIRECTORY = @CMAKE_BINARY_DIR@/docs

INPUT = @CMAKE_SOURCE_DIR@/pattern/include \
        @CMAKE_SOURCE_DIR@/pattern/src

HTML_EXTRA_STYLESHEET  = @AWESOME_CSS_DIR@/doxygen-awesome.css

HTML_OUTPUT = doxygen
XML_OUTPUT = ../.docs/xml

RECURSIVE = YES

GENERATE_HTML = YES
GENERATE_XML = YES
GENERATE_LATEX = NO

EXTRACT_ALL = YES

GENERATE_TREEVIEW = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = NO