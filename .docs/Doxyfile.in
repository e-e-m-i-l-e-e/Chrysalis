PROJECT_NAME = Chrysalis - @MODULE_NAME@

OUTPUT_DIRECTORY = @DOCUMENTS_DIR@

INPUT = @CMAKE_SOURCE_DIR@/@MODULE_SOURCE@/include @CMAKE_SOURCE_DIR@/@MODULE_SOURCE@/src

HTML_EXTRA_STYLESHEET  = @AWESOME_CSS_DIR@/doxygen-awesome.css

HTML_OUTPUT = @DOXYGEN_HTML_OUTPUT@
XML_OUTPUT = @DOXYGEN_XML_OUTPUT@

RECURSIVE = YES

GENERATE_HTML = YES
GENERATE_XML = YES
GENERATE_LATEX = NO

EXTRACT_ALL = YES

GENERATE_TREEVIEW = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = NO

ALIASES += "uml{1}="

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO