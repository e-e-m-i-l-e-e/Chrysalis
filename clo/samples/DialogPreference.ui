                                                                                                        <string notr="true">	QPushButton
	{
		background: transparent;
		border: 1px solid transparent;
		color: rgba(225, 225, 228, 255);
		outline: none;

		min-height: 18px;
		max-height: 18px;
		height: 18px;

		padding: 0px;
		padding-left: 6px;
		padding-right: 6px;
		qproperty-iconSize: 12px;
	}

	QPushButton:hover, QPushButton:focus
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(225, 225, 228, 255);
	}

	QPushButton:checked
	{
		background: rgba(45, 52, 68, 255);
		color: rgba(110, 185, 255, 255);
	}

	QPushButton:disabled
	{
		background: transparent;
		color: rgba(70, 70, 73, 255);
	}

	QPushButton:checked:disabled
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(70, 70, 73, 255);
	}
</string>
