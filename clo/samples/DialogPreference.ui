                                                                    <string notr="true">	QTableView
	{
		outline: none;
		border: 1px solid transparent;
		background: transparent;
	}
	
	QTableView QHeaderView
	{
		background: transparent;
	}

	QTableView QHeaderView::section
	{
		border: 1px solid transparent;
		background: transparent;
		color: rgba(225, 225, 228, 255);
		border-color: rgba(52, 52, 55, 255);
	}

	QTableView QHeaderView::section:hover
	{
		background: transparent;
		color: rgba(110, 185, 255, 255);
	}

	QTableView QHeaderView::section:selected
	{
		background: rgba(0, 0, 0, 230);
		color: rgba(110, 185, 255, 255);
	}

	QTableView QHeaderView::section:disabled
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(70, 70, 73, 255);
	}

	QTableView[widget-type = Warning] QHeaderView::section
	{
		border-bottom-color: rgba(90, 90, 92, 26);
		border-right-color: rgba(90, 90, 92, 26);
		background: rgba(40, 32, 35, 255);
		color: rgba(255, 97, 125, 255);
	}

	QTableView QTableCornerButton::section
	{
		background: transparent;
		border: 1px solid transparent;
		border-color: rgba(52, 52, 55, 255);
	}

	QTableView::item
	{
		border: 1px solid transparent;
		border-bottom-color: rgba(90, 90, 92, 26);
		border-right-color: rgba(90, 90, 92, 26);
		background: rgba(0, 0, 0, 153);
		color: rgba(225, 225, 228, 255);
	}

	QTableView::item:hover
	{
		background: rgba(0, 0, 0, 153);
		color: rgba(110, 185, 255, 255);
		min-height: 24px;
		max-height: 24px;
	}

	QTableView::item:selected
	{
		background: rgba(45, 52, 68, 255);
		color: rgba(110, 185, 255, 255);
		border: 2px solid;
		border-color: rgba(110, 185, 255, 255);
	}

	QTableView::item:focus
	{
		background: rgba(45, 52, 68, 255);
		color: rgba(110, 185, 255, 255);
	}

	QTableView::item:disabled
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(70, 70, 73, 255);
	}

	QTableView[widget-type=Warning]
	{
		border-bottom-color: rgba(90, 90, 92, 26);
		border-right-color: rgba(90, 90, 92, 26);
		background: rgba(40, 32, 35, 255);
		color: rgba(255, 97, 125, 255);
	}

	QTableView[readOnly=true]
	{
		border-bottom-color: rgba(90, 90, 92, 26);
		border-right-color: rgba(90, 90, 92, 26);
		background: rgba(0, 0, 0, 77);
		color: rgba(225, 225, 228, 255);
	}

	QTableView[widget-type=ReadOnly]::item
	{
		border-bottom-color: rgba(90, 90, 92, 26);
		border-right-color: rgba(90, 90, 92, 26);
		background: rgba(0, 0, 0, 77);
		color: rgba(153, 153, 156, 255);
	}

	QTableView QLineEdit
	{
		background: rgba(45, 52, 68, 255);
		color: rgba(225, 225, 228, 255);
	}

	QTableView QLineEdit:focus
	{
		color: rgba(110, 185, 255, 255);
	}
	QMenu
	{
		background: rgba(30, 30, 33, 255);
		border-radius: 4px;
	}

	QMenu::item
	{
		color: rgba(225, 225, 228, 255);
		background: transparent;
	}

	QMenu::item:hover
	{
		color: rgba(110, 185, 255, 255);
		background: rgba(0, 0, 0, 77);
	}

	QMenu::item:selected
	{
		color: rgba(110, 185, 255, 255);
		background: rgba(45, 52, 68, 255);
	}

	QMenu::item:disabled
	{
		color: rgba(70, 70, 73, 255);
		background: transparent;
	}

	QMenu::separator
	{
		height: 5px;
		background: transparent;
		border: none;
		border-top: 1px solid;
		border-color: rgba(47, 47, 50, 255);
		margin: 2px 0px 2px 0px;
	}

	QMenu::tearoff
	{
		background-image: url(:/Resources/CommonIcon/Dash.svg);
		image: url(:/Resources/CommonIcon/Cut handle Main bar.svg);
		background-repeat: repeat-x;
		background-position: center;
		min-height: 15px;
		max-height: 15px;
		height: 15px;
		padding-top: 1px;
	}
