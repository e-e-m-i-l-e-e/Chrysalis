                                                                <property name="styleSheet">
                                                                    <string notr="true">	QTreeView
	{
		outline: none;
		border: none;
		background: transparent;
	}

	QTreeView::branch:has-siblings:!adjoins-item
	{
		image: none;
	}

	QTreeView::branch:has-siblings:adjoins-item
	{
		image: none;
	}

	QTreeView::branch:!has-children:!has-siblings:adjoins-item
	{
		image: none;
	}

	QTreeView::branch:closed:has-children:has-siblings, QTreeView::branch:has-children:!has-siblings:closed
	{
		image: url(:/Resources/CommonIcon/Tree Shrink Normal.svg);
	}

	QTreeView::branch:open:has-children:has-siblings, QTreeView::branch:open:has-children:!has-siblings
	{
		image: url(:/Resources/CommonIcon/Tree Expand Normal.svg);
	}

	QTreeView::item
	{
		border: none;
		color: rgba(225, 225, 228, 255);
		min-height: 24px;
		max-height: 24px;
		height: 24px;
	}

	QTreeView::item:hover, QTreeView::branch:hover
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(110, 185, 255, 255);
	}

	QTreeView::item:selected, QTreeView::branch:selected
	{
		background: rgba(45, 52, 68, 255);
		color: rgba(110, 185, 255, 255);
	}

	QTreeView::item:disabled, QTreeView::branch:disabled
	{
		background: transparent;
		color: rgba(70, 70, 73, 255);
	}

	QTreeView::indicator
	{
		min-width: 14px;
		max-width: 14px;
		width: 14px;
		min-height: 14px;
		max-height: 14px;
		height: 14px;
		icon-size: 12px;
	}

	QTreeView::indicator:unchecked
	{
		image: url(:/Resources/CommonIcon/Checkbox Off Normal.svg);
	}

	QTreeView::indicator:unchecked:hover
	{
		image: url(:/Resources/CommonIcon/Checkbox Off Selected.svg);
	}

	QTreeView::indicator:checked
	{
		image: url(:/Resources/CommonIcon/Checkbox On Normal.svg);
	}

	QTreeView::indicator:checked, QCheckBox::indicator:checked:hover
	{
		image: url(:/Resources/CommonIcon/Checkbox On Selected.svg);
	}

	QTreeView QLineEdit
	{
		background: rgba(37, 37, 40, 255);
		color: rgba(225, 225, 228, 255);
	}
	QMenu
	{
		background: rgba(30, 30, 33, 255);
		border-radius: 4px;
	}

	QMenu::item
	{
		color: rgba(225, 225, 228, 255);
		background: transparent;
	}

	QMenu::item:hover
	{
		color: rgba(110, 185, 255, 255);
		background: rgba(0, 0, 0, 77);
	}

	QMenu::item:selected
	{
		color: rgba(110, 185, 255, 255);
		background: rgba(45, 52, 68, 255);
	}

	QMenu::item:disabled
	{
		color: rgba(70, 70, 73, 255);
		background: transparent;
	}

	QMenu::separator
	{
		height: 5px;
		background: transparent;
		border: none;
		border-top: 1px solid;
		border-color: rgba(47, 47, 50, 255);
		margin: 2px 0px 2px 0px;
	}

	QMenu::tearoff
	{
		background-image: url(:/Resources/CommonIcon/Dash.svg);
		image: url(:/Resources/CommonIcon/Cut handle Main bar.svg);
		background-repeat: repeat-x;
		background-position: center;
		min-height: 15px;
		max-height: 15px;
		height: 15px;
		padding-top: 1px;
	}
	QTreeView::branch:has-siblings:!adjoins-item
	{
		image: url(:/Resources/CommonIcon/Tree Bridge Normal.svg);
	}
	
	QTreeView::branch:has-siblings:adjoins-item
	{
		image: url(:/Resources/CommonIcon/Tree Center Normal.svg);
	}
	
	QTreeView::branch:!has-children:!has-siblings:adjoins-item
	{
		image: url(:/Resources/CommonIcon/Tree End Normal.svg);
	}
</string>
