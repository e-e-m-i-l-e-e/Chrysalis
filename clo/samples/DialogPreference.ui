                                                                            <property name="styleSheet">
                                                                                <string notr="true">	QRadioButton
	{
		border: none;
		background: transparent;
		color: rgba(225, 225, 228, 255);
		outline: none;
		spacing: 6px;
	}

	QRadioButton:hover, QRadioButton:checked, QRadioButton:focus
	{
		color: rgba(225, 225, 228, 255);
	}

	QRadioButton::indicator
	{
		width: 12px;
		height: 12px;
	}

	QRadioButton::indicator:unchecked
	{
		image: url(:/Resources/CommonIcon/Radio Button Off Normal.svg);
	}

	QRadioButton::indicator:unchecked:hover, QRadioButton::indicator:unchecked:focus
	{
		image: url(:/Resources/CommonIcon/Radio Button Off Selected.svg);
	}

	QRadioButton::indicator:checked, QRadioButton::indicator:checked:hover, QRadioButton::indicator:checked:focus
	{
		image: url(:/Resources/CommonIcon/Radio Button On Selected.svg);
	}

	QRadioButton:disabled
	{
		color: rgba(70, 70, 73, 255);
	}

	QRadioButton::indicator:unchecked:disabled
	{
		image: url(:/Resources/CommonIcon/Radio Button Off Disabled.svg);
	}

	QRadioButton::indicator:checked:disabled
	{
		image: url(:/Resources/CommonIcon/Radio Button On Disabled.svg);
	}

	QRadioButton[widget-type=Warning]
	{
		color: rgba(255, 97, 125, 255);
	}

	QRadioButton[widget-type=Warning]::indicator:unchecked
	{
		image: url(:/Resources/CommonIcon/Radio Button Off Warning.svg);
	}

	QRadioButton[widget-type=Warning]::indicator:checked
	{
		image: url(:/Resources/CommonIcon/Radio Button On Warning.svg);
	}
</string>
