                                                                                                                    <string notr="true">	QLabel
	{
		background: transparent;
		border: none;
		color: rgba(225, 225, 228, 255);
	}

	QLabel:disabled
	{
		color: rgba(70, 70, 73, 255);
	}

	QLabel[widget-type=Warning]
	{
		color: rgba(255, 97, 125, 255);
	}

	QLabel[widget-type=Hover]
	{
		color: rgba(110, 185, 255, 255);
	}

	QLabel[widget-type=Active]
	{
		color: rgba(110, 185, 255, 255);
	}

	QLabel[widget-type=Highlight]
	{
		color: rgba(110, 185, 255, 255);
	}

	QLabel[widget-type=Highlight]:disabled
	{
		color: rgba(70, 70, 73, 255);
	}

	QLabel[widget-type=ReadOnly]
	{
		background: transparent;
		color: rgba(153, 153, 156, 255);
	}

	QLabel[widget-type=Disabled]
	{
		background: transparent;
		color: rgba(70, 70, 73, 255);
	}
