	}

	QAbstractSpinBox:focus
	{
		background: rgba(45, 52, 68, 255);
		color: rgba(110, 185, 255, 255);
	}

	QAbstractSpinBox::up-button
	{
		subcontrol-origin: border;
		subcontrol-position: top right;

		background: transparent;
		border: none;
	}

	QAbstractSpinBox::up-arrow
	{
		image: url(:/Resources/CommonIcon/Spin Up Normal.svg);
	}

	QAbstractSpinBox::up-arrow:hover
	{
		image: url(:/Resources/CommonIcon/Spin Up Selected.svg);
	}

	QAbstractSpinBox::up-arrow:pressed
	{
		image: url(:/Resources/CommonIcon/Spin Up Pressed.svg);
	}

	QAbstractSpinBox::up-arrow:disabled
	{
		image: url(:/Resources/CommonIcon/Spin Up Disabled.svg);
	}

	QAbstractSpinBox::down-button
	{
		subcontrol-origin: border;
		subcontrol-position: bottom right;

		background: transparent;
		border: none;
	}

	QAbstractSpinBox::down-arrow
	{
		image: url(:/Resources/CommonIcon/Spin Down Normal.svg);
	}

	QAbstractSpinBox::down-arrow:hover
	{
		image: url(:/Resources/CommonIcon/Spin Down Selected.svg);
	}

	QAbstractSpinBox::down-arrow:pressed
	{
		image: url(:/Resources/CommonIcon/Spin Down Press.svg);
	}

	QAbstractSpinBox::down-arrow:disabled
	{
		image: url(:/Resources/CommonIcon/Spin Down Disabled.svg);
	}

	QAbstractSpinBox[widget-type=Warning]
	{
		background: rgba(40, 32, 35, 255);
		color: rgba(255, 97, 125, 255);
	}

	QAbstractSpinBox[widget-type=Highlight]
	{
		background: rgba(45, 52, 68, 255);
		color: rgba(110, 185, 255, 255);
	}

	QAbstractSpinBox[widget-type=ReadOnly]
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(153, 153, 156, 255);
	}
	QAbstractSpinBox
	{
		border-radius: 4px;

		min-height: 22px;
		max-height: 22px;
		height: 22px;
		spacing: 6px;
		padding-left: 6px;
		padding-right: 2px;
		padding-top: 0px;
		padding-bottom: 0px;
	}

	QAbstractSpinBox::up-button
	{
		width: 18px;
		height: 11px;
	}

	QAbstractSpinBox::up-arrow
	{
		width: 18px;
		height: 18px;
	}

	QAbstractSpinBox::down-button
	{
		width: 18px;
		height: 11px;
	}

	QAbstractSpinBox::down-arrow
	{
		width: 18px;
		height: 18px;
	}
</string>
