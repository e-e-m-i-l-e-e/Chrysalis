                                                                                        <property name="styleSheet">
                                                                                            <string notr="true">	QComboBox 
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(225, 225, 228, 255);
	}

	QComboBox::drop-down
	{
		subcontrol-position: center right;
		background: transparent;
	}

	QComboBox:disabled
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(70, 70, 73, 255);
	}

	QComboBox::down-arrow:disabled
	{
		image: url(:/Resources/CommonIcon/Arrow Down Disabled.svg);
	}
	
	QComboBox QAbstractItemView
	{
		background: rgba(30, 30, 33, 255);
		color: rgba(225, 225, 228, 255);
		selection-background-color: rgba(45, 52, 68, 255);
		selection-color: rgba(110, 185, 255, 255);
		outline: none;
	}

	QComboBox[widget-type=Warning]
	{
		background: rgba(40, 32, 35, 255);
		color: rgba(255, 97, 125, 255);
	}

	QComboBox[widget-type=Highlight]
	{
		background: rgba(45, 52, 68, 255);
		color: rgba(110, 185, 255, 255);
	}

	QComboBox[widget-type=ReadOnly]
	{
		background: rgba(0, 0, 0, 77);
		color: rgba(153, 153, 156, 255);
	}
	QComboBox 
	{
		border-radius: 4px;
		min-height: 22px;
		max-height: 22px;
		icon-size: 14px;
		padding: 2px;
		padding-left: 6px;
	}

	QComboBox::drop-down
	{
		width: 22px;
		height: 22px;
	}

	QComboBox::down-arrow
	{
		width: 18px;
		height: 18px;
	}

	QComboBox QAbstractItemView
	{
		padding: 4px;
		icon-size: 12px;
	}
	QComboBox::down-arrow
	{
		image: url(:/Resources/CommonIcon/Arrow Down Normal.svg);
	}

	QComboBox::down-arrow:hover
	{
		image: url(:/Resources/CommonIcon/Arrow Down Selected.svg);
	}

	QComboBox::down-arrow:on, QComboBox::down-arrow:hover:on
	{
		image: url(:/Resources/CommonIcon/Arrow Up Selected.svg);
	}

	QComboBox[widget-type=Warning]::down-arrow
	{
		image: url(:/Resources/CommonIcon/Arrow Down Warning.svg);
	}

	QComboBox[widget-type=Warning]::down-arrow:on
	{
		image: url(:/Resources/CommonIcon/Arrow Up Warning.svg);
	}

	QComboBox[widget-type=Highlight]::down-arrow
	{
		image: url(:/Resources/CommonIcon/Arrow Down Selected.svg);
	}

	QComboBox[widget-type=Highlight]::down-arrow:on
	{
		image: url(:/Resources/CommonIcon/Arrow Up Selected.svg);
	}
	QScrollBar
	{
		background: rgba(0, 0, 0, 153);
		border: none;
	}

	QScrollBar::handle
	{
		background: rgba(90, 90, 92, 255);
		border: 1px solid transparent;
		border-radius: 3px;
		margin: 1px;
	}

	QScrollBar::handle:vertical
	{
		min-height: 9px;
	}

	QScrollBar::handle:horizontal
	{
		min-width: 9px;
	}

	QScrollBar::handle:hover
	{
		background: rgba(90, 90, 92, 255);
		border-color: rgba(225, 225, 228, 255);
	}

	QScrollBar::handle:pressed
	{
		background: rgba(52, 80, 130, 255);
		border-color: rgba(110, 185, 255, 255);
	}

	QScrollBar::add-line, QScrollBar::sub-line
	{
		border: none;
		background: transparent;
	}
	
	QScrollBar::add-page, QScrollBar::sub-page
	{
		background: rgba(0, 0, 0, 77);
	}

	QScrollBar:horizontal
	{
		height: 10px;
	}

	QScrollBar::handle:horizontal
	{
		height: 6px;
	}

	QScrollBar:vertical
	{
		width: 10px;
	}

	QScrollBar::handle:vertical
	{
		width: 6px;
	}
</string>
