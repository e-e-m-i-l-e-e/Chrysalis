          <property name="styleSheet">
           <string notr="true">	QCheckBox
            {
            background: transparent;
            border: none;
            color: rgba(225, 225, 228, 255);
            outline: none;
            }

            QCheckBox:hover, QCheckBox:checked, QCheckBox:focus
            {
            color: rgba(225, 225, 228, 255);
            }

            QCheckBox:disabled
            {
            color: rgba(70, 70, 73, 255);
            }

            QCheckBox::indicator:unchecked:hover, QCheckBox::indicator:unchecked:focus
            {
            image: url(:/Resources/CommonIcon/Checkbox Off Selected.svg);
            }

            QCheckBox::indicator:unchecked:disabled
            {
            image: url(:/Resources/CommonIcon/Checkbox Off Disabled.svg);
            }

            QCheckBox[widget-type=Warning]
            {
            color: rgba(255, 97, 125, 255);
            }

            QCheckBox[widget-type=Warning]::indicator:unchecked
            {
            image: url(:/Resources/CommonIcon/Checkbox Off Warning.svg);
            }
            QCheckBox
            {
            spacing: 6px;
            }

            QCheckBox::indicator
            {
            width: 12px;
            height: 12px;
            }
            QCheckBox::indicator:unchecked
            {
            image: url(:/Resources/CommonIcon/Checkbox Off Normal.svg);
            }

            QCheckBox::indicator:checked, QCheckBox::indicator:checked:hover, QCheckBox::indicator:checked:focus
            {
            image: url(:/Resources/CommonIcon/Checkbox On Selected.svg);
            }

            QCheckBox::indicator:checked:disabled
            {
            image: url(:/Resources/CommonIcon/Checkbox On Disabled.svg);
            }

            QCheckBox[widget-type=Warning]::indicator:checked
            {
            image: url(:/Resources/CommonIcon/Checkbox On Warning.svg);
            }
           </string>
