             <item>
              <widget class="QTableWidget" name="tableWidget">
               <property name="styleSheet">
                <string notr="true">	QTableView
                 {
                 outline: none;
                 border: 1px solid transparent;
                 background: transparent;
                 }

                 QTableView QHeaderView
                 {
                 background: transparent;
				 padding:4px
                 }

                 QTableView QHeaderView::section
                 {
                 border: 1px solid transparent;
                 background: transparent;
                 color: rgba(225, 225, 228, 255);
                 border-color: rgba(52, 52, 55, 255);
                 }

                 QTableView QHeaderView::section:hover
                 {
                 background: transparent;
                 color: rgba(110, 185, 255, 255);
                 }

                 QTableView QHeaderView::section:selected
                 {
                 background: rgba(0, 0, 0, 230);
                 color: rgba(110, 185, 255, 255);
                 }

                 QTableView QHeaderView::section:disabled
                 {
                 background: rgba(0, 0, 0, 77);
                 color: rgba(70, 70, 73, 255);
                 }

                 QTableView[widget-type = Warning] QHeaderView::section
                 {
                 border-bottom-color: rgba(90, 90, 92, 26);
                 border-right-color: rgba(90, 90, 92, 26);
                 background: rgba(40, 32, 35, 255);
                 color: rgba(255, 97, 125, 255);
                 }

                 QTableView QTableCornerButton::section
                 {
                 background: transparent;
                 border: 1px solid transparent;
                 border-color: rgba(52, 52, 55, 255);
                 }

                 QTableView::item
                 {
                 border: 1px solid transparent;
                 border-bottom-color: rgba(90, 90, 92, 26);
                 border-right-color: rgba(90, 90, 92, 26);
                 background: rgba(0, 0, 0, 153);
                 color: rgba(225, 225, 228, 255);
                 }

                 QTableView::item:hover
                 {
                 background: rgba(0, 0, 0, 153);
                 color: rgba(110, 185, 255, 255);
                 min-height: 24px;
                 max-height: 24px;
                 }

                 QTableView::item:selected
                 {
                 background: rgba(45, 52, 68, 255);
                 color: rgba(110, 185, 255, 255);
                 border: 2px solid;
                 border-color: rgba(110, 185, 255, 255);
                 }

                 QTableView::item:focus
                 {
                 background: rgba(45, 52, 68, 255);
                 color: rgba(110, 185, 255, 255);
                 }

                 QTableView::item:disabled
                 {
                 background: rgba(0, 0, 0, 77);
                 color: rgba(70, 70, 73, 255);
                 }

