compilation_database_dir: ../.build/RelWithDebInfo
output_directory: diagrams
add_compile_flags:
  - /clang:-fparse-all-comments
diagrams:
  CLO3DExtensionsDevToolsClassDiagram:
    type: class
    glob:
      include:
        - ../clo3d/extensions/dev-tools/src/*.cpp
    exclude:
      namespaces:
        - std
        - UI::Ui
      elements:
        - r: "QList.*"
        - type: method
          name:
            r: '.*::(qt_metacall|qt_static_metacall|qt_metacast|metaObject|tr|trUtf8|staticMetaObject)$'
        - type: member
          name:
            r: '.*::staticMetaObject$'
      paths:
        - ../.conan
        - ../common
        - ../clo3d/widgets
      relationships:
        - dependency
    layout:
      BaseUIExporterOptions:
        - down: BaseUIExporterOptions::Keys
        - down: BaseUIExporterOptions::Defaults
      GeneralUIExporterOptions:
        - down: GeneralUIExporterOptions::Keys
        - down: GeneralUIExporterOptions::Defaults
      JsonUIExporterOptions:
        - down: JsonUIExporterOptions::Keys
        - down: JsonUIExporterOptions::Defaults
      XmlUIExporterOptions:
        - down: XmlUIExporterOptions::Keys
        - down: XmlUIExporterOptions::Defaults
    plantuml:
      after:
        - >
          skinparam class {
            BackgroundColor #EAFAF1
            BorderColor #1E8449
            FontColor #0B5345
            AttributeFontColor #1E8449
            StereotypeFontColor #1E8449
            FontStyle Bold
          }
        - >
          skinparam class<<UI>> {
            BackgroundColor #F5EEF8
            BorderColor #8E44AD
            FontColor #4A235A
            AttributeFontColor #6C3483
            StereotypeFontColor #6C3483
          }
        - >
          skinparam class<<Base>> {
            BackgroundColor #F2F3F4
            BorderColor #2C3E50
            BorderThickness 3
            FontSize 16
            FontColor #2C3E50
            AttributeFontColor #566573
            StereotypeFontColor #808B96
            FontStyle Italic
          }
        - >
          {% for e in diagram.elements %}

          {% if e.namespace != "" %}
          class {{ e.alias }} <<{{ e.namespace }}>> {% if replace(e.name, "Base", "") != e.name %}<<Base>>{% endif %}
          {% else if replace(e.name, "Base", "") != e.name %}
          class {{ e.alias }} <<Base>>
          {% else %}
          {% endif %}

          {% endfor %}
  CLO3DExtensionsSettingsSequenceDiagram:
    type: sequence
    generate_message_comments: true
    glob:
      include:
        - ../clo3d/src/*.cpp
        - ../clo3d/extensions/dev-tools/src/*.cpp
    from:
      - function: "UI::ExtensionsSettingsDialog::exec()"
      - function: "UI::ExtensionsSettingsDialog::accept()"
      - function: "UI::ExtensionsSettingsDialog::reject()"
  PatternBuilderClassDiagram:
      type: class
      glob:
        include:
          - ../pattern-builder/src/*.cpp
      exclude:
        namespaces:
          - std
        paths:
          - ../.conan
          - ../common
        relationships:
          - dependency
      plantuml:
        after:
          - >
            skinparam class {
              BackgroundColor #EAFAF1
              BorderColor #1E8449
              FontColor #0B5345
              AttributeFontColor #1E8449
              StereotypeFontColor #1E8449
              FontStyle Bold
            }
          - >
            skinparam class<<UI>> {
              BackgroundColor #F5EEF8
              BorderColor #8E44AD
              FontColor #4A235A
              AttributeFontColor #6C3483
              StereotypeFontColor #6C3483
            }
          - >
            skinparam class<<Builder>> {
              BackgroundColor #F2F3F4
              BorderColor #2C3E50
              BorderThickness 3
              FontSize 16
              FontColor #2C3E50
              AttributeFontColor #566573
              StereotypeFontColor #808B96
              FontStyle Italic
            }
          - >
            {% for e in diagram.elements %}

            {% if e.namespace != "" %}
            class {{ e.alias }} <<{{ e.namespace }}>> {% if replace(e.name, "Builder", "") != e.name %}<<Builder>>{% endif %}
            {% else if replace(e.name, "Builder", "") != e.name %}
            class {{ e.alias }} <<Builder>>
            {% else %}
            {% endif %}

            {% endfor %}