compilation_database_dir: ../.build/RelWithDebInfo/compile_commands.json
output_directory: diagrams
diagrams:
  CLO3DExtensionsDevToolsClassDiagram:
    type: class
    glob:
      include:
        - ../clo3d/src/ExtensionsSettingsDialog.cpp
        - ../clo3d/extensions/dev-tools/src/*.cpp
    exclude:
      namespaces:
        - std
        - UI::Ui
      access:
        - private
      elements:
        - r: "QList.*"
        - type: method
          name:
            r: '.*::(qt_metacall|qt_metacast|metaObject|tr|trUtf8|staticMetaObject)$'
        - type: member
          name:
            r: '.*::staticMetaObject$'
      paths:
        - ../.conan
        - ../common
    layout:
      ExtensionsSettings:
        - left: UI::ExtensionsSettingsDialog
        - down: BaseExtensionsSettingsEditor
      BaseExtensionsSettingsEditor:
        - down: BaseExtensionsSettingsPage
      UI::BaseExtensionsSettingsPageWidget:
        - right: BaseExtensionsSettingsPage
    plantuml:
      after:
        - >
          skinparam class {
            BackgroundColor #EAFAF1
            BorderColor #1E8449
            FontColor #0B5345
            AttributeFontColor #1E8449
            StereotypeFontColor #1E8449
            FontStyle Bold
          }
        - >
          skinparam class<<UI>> {
            BackgroundColor #F5EEF8
            BorderColor #8E44AD
            FontColor #4A235A
            AttributeFontColor #6C3483
            StereotypeFontColor #6C3483
          }
        - >
          skinparam class<<Base>> {
            BackgroundColor #F2F3F4
            BorderColor #2C3E50
            BorderThickness 3
            FontSize 16
            FontColor #2C3E50
            AttributeFontColor #566573
            StereotypeFontColor #808B96
            FontStyle Italic
          }
        - >
          {% for e in diagram.elements %}

          {% if e.namespace != "" %}
          class {{ e.alias }} <<{{ e.namespace }}>> {% if replace(e.name, "Base", "") != e.name %}<<Base>>{% endif %}
          {% else if replace(e.name, "Base", "") != e.name %}
          class {{ e.alias }} <<Base>>
          {% else %}
          {% endif %}

          {% endfor %}
  CLO3DExtensionsDevToolsSequenceDiagram:
    type: sequence
    inline_lambda_messages: true
    glob:
      include:
        - ../clo3d/include/*.h
        - ../clo3d/src/*.cpp
        - ../clo3d/extensions/dev-tools/include/*.h
        - ../clo3d/extensions/dev-tools/src/*.cpp
    from_to:
        - [function: "UI::ExtensionsSettingsDialog::exec()",
           function: "UI::BaseUIExporterOptionsWidget::read(Settings &)"]