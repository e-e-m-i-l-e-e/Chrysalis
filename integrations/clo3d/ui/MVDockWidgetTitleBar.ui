        <property name="styleSheet">
            <string notr="true">	.TitleBar_Widget
                {
                background: rgba(30, 30, 33, 255);
                border: none;
                }
                QScrollBar
                {
                background: rgba(0, 0, 0, 153);
                border: none;
                }

                QScrollBar::handle
                {
                background: rgba(90, 90, 92, 255);
                border: 1px solid transparent;
                border-radius: 3px;
                margin: 1px;
                }

                QScrollBar::handle:vertical
                {
                min-height: 9px;
                }

                QScrollBar::handle:horizontal
                {
                min-width: 9px;
                }

                QScrollBar::handle:hover
                {
                background: rgba(90, 90, 92, 255);
                border-color: rgba(225, 225, 228, 255);
                }

                QScrollBar::handle:pressed
                {
                background: rgba(52, 80, 130, 255);
                border-color: rgba(110, 185, 255, 255);
                }

                QScrollBar::add-line, QScrollBar::sub-line
                {
                border: none;
                background: transparent;
                }

                QScrollBar::add-page, QScrollBar::sub-page
                {
                background: rgba(0, 0, 0, 77);
                }

                QScrollBar:horizontal
                {
                height: 10px;
                }

                QScrollBar::handle:horizontal
                {
                height: 6px;
                }

                QScrollBar:vertical
                {
                width: 10px;
                }

                QScrollBar::handle:vertical
                {
                width: 6px;
                }
            </string>
        </property>
