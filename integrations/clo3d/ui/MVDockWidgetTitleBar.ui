                                    <string notr="true">	QToolButton
                                        {
                                        background: transparent;
                                        color: rgba(225, 225, 228, 255);
                                        border: none;
                                        margin: 0px;
                                        outline: none;
                                        }

                                        QToolButton:hover, QToolButton:checked:hover, QToolButton:focus
                                        {
                                        background: rgba(45, 52, 68, 255);
                                        border: 1px solid;
                                        border-color: rgba(52, 80, 130, 255);
                                        color: rgba(110, 185, 255, 255);
                                        }

                                        QToolButton:pressed
                                        {
                                        background: rgba(52, 80, 130, 255);
                                        border: none;
                                        color: rgba(110, 185, 255, 255);
                                        }

                                        QToolButton:checked
                                        {
                                        background: transparent;
                                        border: none;
                                        color: rgba(110, 185, 255, 255);
                                        }

                                        QToolButton:disabled
                                        {
                                        background: transparent;
                                        border: none;
                                        color: rgba(70, 70, 73, 255);
                                        }

                                        QToolButton::menu-indicator
                                        {
                                        image: none;
                                        }

                                        QToolButton[widget-type=Normal]
                                        {
                                        background: transparent;
                                        color: rgba(225, 225, 228, 255);
                                        border: none;
                                        margin: 0px;
                                        }
                                        QToolButton[widget-type=Hover]
                                        {
                                        background: rgba(45, 52, 68, 255);
                                        border: 1px solid;
                                        border-color: rgba(52, 80, 130, 255);
                                        color: rgba(110, 185, 255, 255);
                                        margin: -1px;
                                        }
                                        QToolButton[widget-type=Warning]
                                        {
                                        background: transparent;
                                        border: none;
                                        color: rgba(255, 97, 125, 255);
                                        }
                                        QToolButton
                                        {
                                        icon-size: 12px;
                                        min-width: 18px;
                                        max-width: 18px;
                                        min-height: 18px;
                                        max-height: 18px;
                                        border-radius: 2px;
                                        }
                                    </string>
