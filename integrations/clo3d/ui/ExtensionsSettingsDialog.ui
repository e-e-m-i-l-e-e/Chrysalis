       <widget class="QWidget" name="footerWidget" native="true">
        <property name="styleSheet">
         <string notr="true">QPushButton {
    color: rgba(225, 225, 228, 255);
    background: rgba(0, 0, 0, 77);
    border: 1px solid transparent;
    border-radius: 4px;
    outline: none;

    padding: 4px 6px;
    min-height: 16px;
    max-height: 16px;
    height: 16px;
    qproperty-iconSize: 14px;
}

QPushButton:hover,
QPushButton:focus {
    color: rgba(110, 185, 255, 255);
    background: rgba(45, 52, 68, 255);
    border-color: rgba(52, 80, 130, 255);
}

QPushButton:pressed {
    color: rgba(110, 185, 255, 255);
    background: rgba(52, 80, 130, 255);
    border-color: transparent;
}

QPushButton:checked {
    color: rgba(110, 185, 255, 255);
    background: rgba(45, 52, 68, 255);
    border-color: transparent;
}

QPushButton:disabled {
    color: rgba(70, 70, 73, 255);
    background: rgba(0, 0, 0, 77);
    border-color: transparent;
}

QPushButton[widget-type=&quot;Warning&quot;] {
    color: rgba(255, 97, 125, 255);
    background: transparent;
    border-color: transparent;
}

QPushButton[widget-type=&quot;Active&quot;] {
    color: rgba(110, 185, 255, 255);
    background: rgba(45, 52, 68, 255);
    border-color: transparent;
}</string>
